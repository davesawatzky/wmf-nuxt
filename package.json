{
  "name": "wmf-nuxt",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxi build --dotenv .env.production",
    "dev": "nuxi dev --dotenv .env.development",
    "dev:test": "nuxi dev --dotenv .env.test",
    "debug": "nuxi dev --dotenv .env.development --host --inspect",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "lint": "eslint './**/*.{ts,vue}'",
    "lint:fix": "eslint './**/*.{ts,vue}' --fix",
    "story:dev": "dotenvx --env-file=.env.development histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "dotenvx run --env-file=.env.test -- vitest run",
    "test:watch": "dotenvx run --env-file=.env.test -- vitest --watch --ui",
    "test:unit": "dotenvx run --env-file=.env.test -- vitest --watch --ui --project=unit",
    "test:nuxt": "dotenvx run --env-file=.env.test -- vitest watch ui project=nuxt",
    "test:coverage": "dotenvx run --env-file=.env.test -- vitest --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:all": "pnpm test:unit && pnpm test:nuxt && pnpm test:e2e"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@dotenvx/dotenvx": "^2.23.0",
    "@formkit/auto-animate": "0.10.0",
    "@pinia/nuxt": "^1.0.2",
    "@primeuix/themes": "^1.2.5",
    "@primevue/core": "4.5.5",
